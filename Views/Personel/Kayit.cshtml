@{
    ViewData["Title"] = "Personel Kaydı";
    var kategoriler = ViewBag.Kategoriler as string[] ?? Array.Empty<string>();
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill text-success fs-1"></i>
                    <h4 class="fw-bold mt-2 mb-1">Personel Kaydı</h4>
                    <p class="text-muted small mb-0">Bilgilerinizi gönderin, admin onayından sonra giriş yapın</p>
                </div>

                @if (ViewBag.Hata != null)
                {
                    <div class="alert alert-danger small">@ViewBag.Hata</div>
                }

                <div class="alert alert-light border small d-flex gap-2 align-items-start">
                    <i class="bi bi-hourglass-split text-success"></i>
                    <span>Kayıt isteği gönderildikten sonra admin paneline düşer. Admin onaylayınca aynı kullanıcı adı ve şifreyle giriş yapabilirsiniz.</span>
                </div>

                @if (ViewBag.Mesaj != null)
                {
                    <div class="alert alert-success">
                        <div class="fw-bold mb-1">@ViewBag.Mesaj</div>
                    </div>
                }

                <form asp-action="Kayit" asp-controller="Personel" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Kullanıcı Adı</label>
                        <input type="text" name="kullaniciAdi" class="form-control" maxlength="30" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">E-posta</label>
                        <input type="email" name="eposta" class="form-control" maxlength="120" required>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted">Şifre</label>
                            <input type="password" name="sifre" class="form-control" minlength="4" maxlength="60" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold text-muted">Şifre Tekrar</label>
                            <input type="password" name="sifreTekrar" class="form-control" minlength="4" maxlength="60" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-muted">Görev Kategorisi</label>
                        <select name="gorevKategori" class="form-select" required>
                            <option value="">Kategori seçin...</option>
                            @foreach (var kategori in kategoriler)
                            {
                                <option value="@kategori">@ArizaKategorileri.Etiketler[kategori]</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Güvenlik Kodu</label>
                        <div class="d-flex gap-2">
                            <div class="px-3 py-2 bg-light border rounded fw-bold text-success">@ViewBag.GuvenlikKodu</div>
                            <input type="text" name="guvenlikKodu" class="form-control" maxlength="6" placeholder="Kodu yazın" required>
                        </div>
                        <a asp-action="Kayit" class="small text-decoration-none d-inline-block mt-1">Kodu yenile</a>
                    </div>

                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold">Kayıt İsteği Gönder</button>
                </form>

                <div class="text-center mt-3 small">
                    <a asp-action="Login" class="text-decoration-none text-secondary">Zaten hesabım var</a>
                </div>
            </div>
        </div>
    </div>
</div>
