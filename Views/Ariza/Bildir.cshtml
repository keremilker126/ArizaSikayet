@model ArizaSikayet.Models.Ariza

@{
    var kategoriler = ViewBag.Kategoriler as string[] ?? ArizaKategorileri.TumKategoriler;
    ViewData["Title"] = "Arıza Bildirim Formu";
}

<div class="container mt-4 mb-5">

    <div class="row justify-content-center">

        <!-- BAŞLIK -->
        <div class="col-12 text-center mb-4">

            <h2 class="fw-bold text-dark text-uppercase"
                style="letter-spacing:1px;">

                <span class="border-bottom border-danger border-3 pb-2">
                    Arıza Bildirim Portalı
                </span>

            </h2>

            <p class="text-muted mt-3">
                Lütfen arıza detaylarını eksiksiz doldurun ve haritadan konumu doğrulayın.
            </p>

        </div>

        <!-- SOL FORM -->
        <div class="col-lg-5 col-md-12 mb-4">

            <div class="card border-0 shadow-lg h-100"
                 style="border-radius:22px; overflow:hidden;">

                <!-- HEADER -->
                <div class="card-header bg-dark text-white border-0 p-3">

                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>
                        Bildirim Detayları
                    </h5>

                </div>

                <!-- BODY -->
                <div class="card-body p-4 bg-white">

                    <form asp-action="Bildir"
                          method="post"
                          enctype="multipart/form-data"
                          id="arizaForm">

                        <!-- BAŞLIK -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold text-secondary">
                                Arıza Başlığı
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light text-muted">
                                    <i class="bi bi-tag"></i>
                                </span>

                                <input asp-for="Baslik"
                                       class="form-control border-start-0"
                                       maxlength="30"
                                       placeholder="Örn: Su Borusu Patlağı"
                                       required />

                            </div>

                        </div>

                        <!-- KATEGORİ -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold text-secondary">
                                Kategori
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light text-muted">
                                    <i class="bi bi-list-task"></i>
                                </span>

                                <select asp-for="Kategori"
                                        class="form-select border-start-0"
                                        required>

                                    <option value="">Kategori Seçiniz...</option>
                                    @foreach (var kategori in kategoriler)
                                    {
                                        <option value="@kategori">@ArizaKategorileri.IconluEtiketler[kategori]</option>
                                    }
                                </select>

                            </div>

                        </div>

                        <!-- AÇIKLAMA -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold text-secondary">
                                Açıklama
                            </label>

                            <textarea asp-for="Aciklama"
                                      class="form-control bg-light"
                                      rows="3"
                                      maxlength="100"
                                      placeholder="Sorunu kısaca açıklayın..."
                                      required></textarea>

                        </div>

                        <!-- ADRES -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold text-secondary">
                                Adres / Yer Tarifi
                            </label>

                            <div class="input-group">

                                <textarea asp-for="AdresTarifi"
                                          id="adresText"
                                          class="form-control bg-light"
                                          rows="2"
                                          maxlength="120"
                                          placeholder="Adres girin veya haritadan seçin..."
                                          required></textarea>

                                <button type="button"
                                        class="btn btn-outline-danger fw-bold"
                                        onclick="adresBul()">

                                    <i class="bi bi-search"></i>

                                </button>

                            </div>

                            <small class="text-muted"
                                   style="font-size:0.75rem;">

                                Adres yazıp arama ikonuna basarak haritada konum bulabilirsiniz.
                            </small>

                        </div>

                        <!-- FOTO -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold text-secondary">
                                Arıza Görseli (Max 10MB)
                            </label>

                            <input type="file"
                                   id="fotografInput"
                                   name="fotograf"
                                   class="form-control"
                                   accept="image/jpeg,image/png,image/jpg"
                                   required />

                            <small id="dosyaHata"
                                   class="text-danger d-none">

                                Dosya yalnızca JPG veya PNG olmalı ve 10MB'dan küçük olmalıdır.
                            </small>

                        </div>

                        <!-- GİZLİ INPUT -->
                        <input type="hidden"
                               asp-for="Enlem"
                               id="enlemInput"
                               required />

                        <input type="hidden"
                               asp-for="Boylam"
                               id="boylamInput"
                               required />

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary">
                                Güvenlik Kodu
                            </label>
                            <div class="d-flex gap-2">
                                <div class="px-3 py-2 bg-light border rounded fw-bold text-danger">@ViewBag.GuvenlikKodu</div>
                                <input type="text"
                                       name="guvenlikKodu"
                                       class="form-control"
                                       maxlength="6"
                                       placeholder="Kodu yazın"
                                       required />
                            </div>
                            <a asp-action="Bildir" class="small text-decoration-none d-inline-block mt-1">Kodu yenile</a>
                        </div>

                        <!-- DURUM -->
                        <div id="konumDurumu"
                             class="alert alert-warning py-2 small d-flex align-items-center mb-4">

                            <i class="bi bi-geo-alt-fill me-2 fs-5"></i>

                            <span>
                                Konum bekleniyor...
                            </span>

                        </div>

                        <!-- GÖNDER -->
                        <button type="submit"
                                class="btn btn-dark w-100 py-3 fw-bold text-uppercase shadow-sm">

                            <i class="bi bi-send-fill me-2"></i>
                            Bildirimi Gönder

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- HARİTA -->
        <div class="col-lg-7 col-md-12">

            <div class="card border-0 shadow-lg"
                 style="border-radius:22px; overflow:hidden;">

                <!-- HEADER -->
                <div class="card-header bg-danger text-white border-0 p-3 d-flex justify-content-between align-items-center">

                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-map-fill me-2"></i>
                        Konum Seçimi
                    </h5>

                    <button type="button"
                            class="btn btn-light btn-sm fw-bold px-3"
                            onclick="getLocation(true)">

                        <i class="bi bi-crosshair me-1"></i>
                        BENİ BUL

                    </button>

                </div>

                <!-- MAP -->
                <div class="card-body p-0">

                    <div id="map"
                         style="height:700px; width:100%;"></div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <!-- LEAFLET -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet/dist/leaflet.css" />

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <script>

        // TÜRKİYE SINIRLARI
        const southWest = L.latLng(35.8, 25.5);
        const northEast = L.latLng(42.5, 45.0);

        const trBounds = L.latLngBounds(
            southWest,
            northEast
        );

        // HARİTA
        const map = L.map('map', {

            maxBounds: trBounds,
            maxBoundsViscosity: 1.0,
            minZoom: 6

        }).setView([39.0, 35.0], 6);

        // TILE
        L.tileLayer(
            'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png',
            {
                attribution: '&copy; OpenStreetMap'
            }
        ).addTo(map);

        // DEĞİŞKENLER
        let selectedMarker = null;
        let accuracyCircle = null;
        let userMarker = null;
        let adresGecerli = false;

        // ICONLAR
        const redIcon = L.icon({

            iconUrl:
                'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',

            shadowUrl:
                'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',

            iconSize: [25, 41],
            iconAnchor: [12, 41]

        });

        const blueIcon = L.icon({

            iconUrl:
                'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',

            shadowUrl:
                'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',

            iconSize: [25, 41],
            iconAnchor: [12, 41]

        });

        // DURUM MESAJI
        function durumGuncelle(tip, mesaj) {

            const durum =
                document.getElementById('konumDurumu');

            durum.className =
                `alert alert-${tip} py-2 small d-flex align-items-center mb-4`;

            durum.innerHTML =
                `
                    <i class="bi bi-geo-alt-fill me-2 fs-5"></i>
                    <span>${mesaj}</span>
                `;
        }

        // FORM TEMİZLE
        function temizleForm() {

            adresGecerli = false;

            document.getElementById('enlemInput').value = "";
            document.getElementById('boylamInput').value = "";

            if (selectedMarker) {
                map.removeLayer(selectedMarker);
            }

            durumGuncelle(
                "danger",
                "Geçerli bir konum seçilmedi."
            );
        }

        // KONUM İŞARETLE
        async function isaretle(lat, lng, zoom = true) {

            // TÜRKİYE KONTROL
            if (!trBounds.contains([lat, lng])) {

                temizleForm();

                alert(
                    "Lütfen Türkiye sınırları içinde konum seçin."
                );

                return;
            }

            try {

                const response =
                    await fetch(
                        `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=tr`
                    );

                const data = await response.json();

                if (
                    !data.address ||
                    data.address.country_code !== "tr"
                ) {

                    temizleForm();

                    alert(
                        "Konum doğrulanamadı."
                    );

                    return;
                }

                adresGecerli = true;

                // ESKİ MARKER
                if (selectedMarker) {
                    map.removeLayer(selectedMarker);
                }

                // YENİ MARKER
                selectedMarker =
                    L.marker([lat, lng], {
                        icon: redIcon
                    })
                    .addTo(map)
                    .bindPopup(
                        "<b>Arıza Konumu Onaylandı</b>"
                    )
                    .openPopup();

                // INPUT
                document.getElementById('enlemInput').value = lat;
                document.getElementById('boylamInput').value = lng;

                // ADRES
                if (data.display_name) {

                    document.getElementById('adresText')
                        .value = data.display_name;
                }

                // HARİTA ODAK
                if (zoom) {

                    map.flyTo(
                        [lat, lng],
                        17,
                        {
                            animate: true,
                            duration: 1.2
                        }
                    );
                }

                // DURUM
                durumGuncelle(
                    "success",
                    `Konum doğrulandı • ${data.address.province || "Türkiye"}`
                );

            }
            catch {

                temizleForm();

                alert(
                    "Konum doğrulama sırasında hata oluştu."
                );
            }
        }

        // ADRES BUL
        async function adresBul() {

            const adres =
                document.getElementById('adresText')
                    .value
                    .trim();

            if (adres.length < 5) {

                alert(
                    "Lütfen daha detaylı adres girin."
                );

                return;
            }

            try {

                durumGuncelle(
                    "warning",
                    "Adres aranıyor..."
                );

                const response =
                    await fetch(
                        `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(adres)}&countrycodes=tr&limit=1`
                    );

                const data = await response.json();

                if (data.length === 0) {

                    temizleForm();

                    alert(
                        "Adres bulunamadı."
                    );

                    return;
                }

                const lat = parseFloat(data[0].lat);
                const lon = parseFloat(data[0].lon);

                await isaretle(lat, lon);

            }
            catch {

                temizleForm();

                alert(
                    "Adres doğrulama hatası oluştu."
                );
            }
        }

        // HARİTAYA TIKLAMA
        map.on('click', function (e) {

            isaretle(
                e.latlng.lat,
                e.latlng.lng
            );

        });

        // GPS KONUM
        function getLocation(auto = false) {

            if (!navigator.geolocation) {

                durumGuncelle(
                    "danger",
                    "Tarayıcı konum desteği bulunamadı."
                );

                return;
            }

            durumGuncelle(
                "warning",
                "GPS konumu alınıyor..."
            );

            navigator.geolocation.getCurrentPosition(

                async function (position) {

                    const lat =
                        position.coords.latitude;

                    const lng =
                        position.coords.longitude;

                    const accuracy =
                        position.coords.accuracy;

                    // TÜRKİYE DIŞI
                    if (!trBounds.contains([lat, lng])) {

                        durumGuncelle(
                            "danger",
                            "Türkiye dışında konum algılandı."
                        );

                        map.setView([39.0, 35.0], 6);

                        return;
                    }

                    // ESKİLERİ TEMİZLE
                    if (userMarker) {
                        map.removeLayer(userMarker);
                    }

                    if (accuracyCircle) {
                        map.removeLayer(accuracyCircle);
                    }

                    // MAVİ GPS İŞARETİ
                    userMarker =
                        L.marker([lat, lng], {
                            icon: blueIcon
                        })
                        .addTo(map)
                        .bindPopup(
                            `GPS Konumunuz<br>Hassasiyet: ${Math.round(accuracy)} metre`
                        );

                    // HASSASİYET ÇEMBERİ
                    accuracyCircle =
                        L.circle([lat, lng], {

                            radius: accuracy,
                            fillOpacity: 0.12

                        }).addTo(map);

                    // HARİTA ODAK
                    map.flyTo(
                        [lat, lng],
                        18,
                        {
                            animate: true,
                            duration: 1.5
                        }
                    );

                    // NOKTA ATIŞI İŞARETLE
                    await isaretle(lat, lng, false);

                    durumGuncelle(
                        "success",
                        `GPS konumu başarıyla bulundu • Hassasiyet: ${Math.round(accuracy)} metre`
                    );

                },

                function (error) {

                    console.log(error);

                    durumGuncelle(
                        "danger",
                        "Konum izni verilmedi veya GPS alınamadı."
                    );

                },

                {
                    enableHighAccuracy: true,
                    timeout: 15000,
                    maximumAge: 0
                }
            );
        }

        // ADRES DEĞİŞİNCE
        document.getElementById('adresText')
            .addEventListener('input', function () {

                adresGecerli = false;

                document.getElementById('enlemInput').value = "";
                document.getElementById('boylamInput').value = "";

                durumGuncelle(
                    "warning",
                    "Adres değiştirildi. Tekrar doğrulama gerekli."
                );
            });

        // DOSYA KONTROL
        document.getElementById('fotografInput')
            .addEventListener('change', function () {

                const file = this.files[0];

                const errorMsg =
                    document.getElementById('dosyaHata');

                const maxSize =
                    10 * 1024 * 1024;

                const allowedTypes = [

                    'image/jpeg',
                    'image/png',
                    'image/jpg'

                ];

                if (file) {

                    if (
                        file.size > maxSize ||
                        !allowedTypes.includes(file.type)
                    ) {

                        errorMsg.classList.remove('d-none');

                        this.value = '';

                        alert(
                            "Lütfen yalnızca 10MB altı JPG veya PNG yükleyin."
                        );

                    }
                    else {

                        errorMsg.classList.add('d-none');
                    }
                }
            });

        // FORM SUBMIT
        document.getElementById('arizaForm')
            .addEventListener('submit', function (e) {

                const enlem =
                    document.getElementById('enlemInput').value;

                const boylam =
                    document.getElementById('boylamInput').value;

                const file =
                    document.getElementById('fotografInput').files[0];

                // KONUM
                if (!enlem || !boylam) {

                    e.preventDefault();

                    alert(
                        "Lütfen haritadan geçerli konum seçin."
                    );

                    return;
                }

                // ADRES
                if (!adresGecerli) {

                    e.preventDefault();

                    alert(
                        "Adres doğrulanamadı."
                    );

                    return;
                }

                // DOSYA
                if (
                    file &&
                    file.size > 10 * 1024 * 1024
                ) {

                    e.preventDefault();

                    alert(
                        "Dosya boyutu 10MB'dan büyük olamaz."
                    );

                    return;
                }
            });

        // SAYFA AÇILINCA GPS
        window.onload = function () {

            getLocation(true);

        };

    </script>
}

