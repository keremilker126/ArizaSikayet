@model List<ArizaSikayet.Models.Ariza>

@functions {
    private static double KoordinatDuzelt(double deger, double limit)
    {
        while (Math.Abs(deger) > limit)
        {
            deger /= 10;
        }

        return deger;
    }

    private static string HaritaYolTarifiUrl(double enlem, double boylam)
    {
        var lat = KoordinatDuzelt(enlem, 90).ToString(System.Globalization.CultureInfo.InvariantCulture);
        var lng = KoordinatDuzelt(boylam, 180).ToString(System.Globalization.CultureInfo.InvariantCulture);
        return $"https://www.google.com/maps/dir/?api=1&destination={lat},{lng}&travelmode=driving";
    }

    private static string DurumBadgeClass(ArizaDurumu durum)
    {
        return durum switch
        {
            ArizaDurumu.Beklemede => "bg-secondary",
            ArizaDurumu.Inceleniyor => "bg-info text-dark",
            ArizaDurumu.Onariliyor => "bg-warning text-dark",
            ArizaDurumu.Tamamlandi => "bg-success",
            ArizaDurumu.IptalEdildi => "bg-danger",
            _ => "bg-secondary"
        };
    }
}

@{
    ViewData["Title"] = "Personel Paneli";
    var kategori = ViewBag.Kategori as string ?? "";
    var aktifArizalar = Model.Where(x => !x.CozulduMu).ToList();
    var tamamlananArizalar = Model.Where(x => x.CozulduMu).ToList();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-workspace text-primary me-2"></i>Personel Paneli</h2>
        <div class="text-muted small">Görev kategoriniz: <strong>@kategori</strong></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="SifreDegistir" class="btn btn-outline-warning rounded-pill px-3">
            <i class="bi bi-key"></i> Şifre Değiştir
        </a>
        <a asp-action="Logout" class="btn btn-outline-danger rounded-pill px-3">
            <i class="bi bi-box-arrow-right"></i> Çıkış
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="bg-white border rounded-3 p-3 shadow-sm">
            <div class="small text-muted">Aktif Arızalar</div>
            <div class="fs-4 fw-bold text-danger">@aktifArizalar.Count</div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="bg-white border rounded-3 p-3 shadow-sm">
            <div class="small text-muted">Tamamlanan Arızalar</div>
            <div class="fs-4 fw-bold text-success">@tamamlananArizalar.Count</div>
        </div>
    </div>
</div>

<ul class="nav nav-pills mb-4" role="tablist">
    <li class="nav-item">
        <button class="nav-link active rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#listeTab">
            <i class="bi bi-list-task me-2"></i>Liste
        </button>
    </li>
    <li class="nav-item ms-2">
        <button class="nav-link rounded-pill px-4 border" id="personelHaritaBtn" data-bs-toggle="pill" data-bs-target="#haritaTab">
            <i class="bi bi-map me-2"></i>Harita
        </button>
    </li>
    <li class="nav-item ms-2">
        <button class="nav-link rounded-pill px-4 border" data-bs-toggle="pill" data-bs-target="#tamamlananTab">
            <i class="bi bi-archive me-2"></i>Tamamlanan
        </button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="listeTab">
        <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center mb-3">
                    <div class="col-md-8">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" id="aktifArizaArama" class="form-control" placeholder="Başlık veya adrese göre ara...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select id="aktifDurumFiltre" class="form-select form-select-sm">
                            <option value="">Tüm durumlar</option>
                            <option value="Beklemede">Beklemede</option>
                            <option value="Inceleniyor">İnceleniyor</option>
                            <option value="Onariliyor">Onarılıyor</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="text-muted small text-uppercase">
                            <tr>
                                <th>Görsel</th>
                                <th>Arıza</th>
                                <th>Bildiren</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in aktifArizalar)
                            {
                                var aramaMetni = $"{item.Baslik} {item.AdresTarifi}".ToLower(new System.Globalization.CultureInfo("tr-TR"));

                                <tr class="personel-ariza-row" data-durum="@item.Durum.ToString()" data-search="@aramaMetni">
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(item.FotografYolu) ? "/img/no-image.png" : item.FotografYolu)"
                                             class="rounded shadow-sm" style="width:78px;height:58px;object-fit:cover;" alt="Arıza Foto">
                                    </td>
                                    <td>
                                        <div class="fw-bold">@item.Baslik</div>
                                        <div class="small text-muted">@item.AdresTarifi</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@(item.Vatandas?.KullaniciAdi ?? "Bilinmiyor")</div>
                                        <div class="small text-muted">@(item.Vatandas?.Eposta ?? "-")</div>
                                    </td>
                                    <td><span class="badge @DurumBadgeClass(item.Durum) rounded-pill">@item.Durum</span></td>
                                    <td class="small">@item.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                                            <a href="@HaritaYolTarifiUrl(item.Enlem, item.Boylam)"
                                               target="_blank"
                                               class="btn btn-sm btn-primary rounded-pill px-3">
                                                <i class="bi bi-sign-turn-right-fill"></i> Yol Tarifi
                                            </a>

                                            <form asp-action="DurumGuncelle" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />

                                                @if (item.Durum == ArizaDurumu.Beklemede)
                                                {
                                                    <input type="hidden" name="yeniDurum" value="@ArizaDurumu.Inceleniyor" />
                                                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3"
                                                            onclick="return confirm('Arızayı incelemeye almak istediğinize emin misiniz?')">
                                                        <i class="bi bi-search"></i> İncelet
                                                    </button>
                                                }
                                                else if (item.Durum == ArizaDurumu.Inceleniyor)
                                                {
                                                    <input type="hidden" name="yeniDurum" value="@ArizaDurumu.Onariliyor" />
                                                    <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3"
                                                            onclick="return confirm('Onarım sürecini başlatmak istediğinize emin misiniz?')">
                                                        <i class="bi bi-tools"></i> Onart
                                                    </button>
                                                }
                                                else if (item.Durum == ArizaDurumu.Onariliyor)
                                                {
                                                    <input type="hidden" name="yeniDurum" value="@ArizaDurumu.Tamamlandi" />
                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3"
                                                            onclick="return confirm('Arıza giderildi mi? Bu işlem geri alınamaz.')">
                                                        <i class="bi bi-check-lg"></i> Tamamla
                                                    </button>
                                                }
                                            </form>

                                            <form asp-action="DurumGuncelle" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="yeniDurum" value="@ArizaDurumu.IptalEdildi" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                        onclick="return confirm('Bu ihbarı iptal etmek istediğinize emin misiniz?')">
                                                    İptal
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!aktifArizalar.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">Bu kategoride aktif arıza yok.</td></tr>
                            }
                            <tr id="filtreBosSatir" class="d-none">
                                <td colspan="6" class="text-center text-muted py-4">Aramanıza uygun aktif arıza bulunamadı.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="haritaTab">
        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="card-header bg-white p-3">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <strong><i class="bi bi-broadcast-pin text-danger me-2"></i>@kategori Haritası</strong>

                    <div class="input-group input-group-sm shadow-sm" style="max-width:420px; border-radius:30px; overflow:hidden;">
                        <input type="text"
                               id="personelAddressSearchInput"
                               class="form-control border-primary ps-3"
                               placeholder="Adres, mahalle veya sokak yazın...">
                        <button class="btn btn-primary px-4" type="button" onclick="personelAdresAra()">
                            <i class="bi bi-search"></i> Git
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="personelMap" style="height:70vh;width:100%;"></div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="tamamlananTab">
        <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-body p-3">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="text-muted small text-uppercase">
                            <tr>
                                <th>Arıza</th>
                                <th>Bildiren</th>
                                <th>Adres</th>
                                <th>Tarih</th>
                                <th class="text-end">Yol</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in tamamlananArizalar)
                            {
                                <tr>
                                    <td class="fw-bold">@item.Baslik</td>
                                    <td>
                                        <div class="fw-semibold">@(item.Vatandas?.KullaniciAdi ?? "Bilinmiyor")</div>
                                        <div class="small text-muted">@(item.Vatandas?.Eposta ?? "-")</div>
                                    </td>
                                    <td class="small text-muted">@item.AdresTarifi</td>
                                    <td class="small">@item.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        <a href="@HaritaYolTarifiUrl(item.Enlem, item.Boylam)"
                                           target="_blank"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="bi bi-sign-turn-right-fill"></i> Yol Tarifi
                                        </a>
                                    </td>
                                </tr>
                            }
                            @if (!tamamlananArizalar.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">Bu kategoride tamamlanan arıza yok.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <style>
        .leaflet-popup-content-wrapper { border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,.14) !important; }
        .popup-img { width: 100%; height: 110px; object-fit: cover; border-radius: 10px; margin-bottom: 8px; border: 1px solid #eee; }
    </style>

    <script>
        const personelArizalar = @Html.Raw(Json.Serialize(Model));
        let personelMap;
        let personelMarkers = [];

        function aktifListeyiFiltrele() {
            const arama = (document.getElementById('aktifArizaArama')?.value || '').toLocaleLowerCase('tr-TR').trim();
            const durum = document.getElementById('aktifDurumFiltre')?.value || '';
            const rows = Array.from(document.querySelectorAll('.personel-ariza-row'));
            let gorunen = 0;

            rows.forEach(row => {
                const aramaUygun = !arama || (row.dataset.search || '').includes(arama);
                const durumUygun = !durum || row.dataset.durum === durum;
                const goster = aramaUygun && durumUygun;

                row.classList.toggle('d-none', !goster);
                if (goster) gorunen++;
            });

            document.getElementById('filtreBosSatir')?.classList.toggle('d-none', gorunen !== 0 || rows.length === 0);
        }

        function normalizeDurum(durum) {
            const durumlar = {
                0: "Beklemede",
                1: "İnceleniyor",
                2: "Onarılıyor",
                3: "Tamamlandı",
                4: "İptal Edildi"
            };

            return durumlar[durum] || durum;
        }

        function markerIconOlustur(cozulduMu) {
            const renk = cozulduMu ? "green" : "red";
            return L.icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${renk}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
        }

        function yolTarifiAl(lat, lng) {
            if (!lat || !lng) return;

            let safeLat = lat.toString().replace(',', '.');
            let safeLng = lng.toString().replace(',', '.');
            let numLat = parseFloat(safeLat);
            let numLng = parseFloat(safeLng);

            while (numLat > 90) numLat /= 10;
            while (numLng > 180) numLng /= 10;

            if (isNaN(numLat) || isNaN(numLng)) return;

            window.open(`https://www.google.com/maps/dir/?api=1&destination=${numLat},${numLng}&travelmode=driving`, '_blank');
        }

        async function personelAdresAra() {
            const input = document.getElementById('personelAddressSearchInput');
            const query = input.value.trim();

            if (!query) return;

            try {
                const response = await fetch(
                    `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&countrycodes=tr&limit=1`
                );

                const data = await response.json();

                if (!data.length) {
                    alert("Adres bulunamadı.");
                    return;
                }

                personelMap.flyTo(
                    [parseFloat(data[0].lat), parseFloat(data[0].lon)],
                    15,
                    {
                        animate: true,
                        duration: 1.5
                    }
                );
            }
            catch {
                alert("Adres arama servisine bağlanılamadı.");
            }
        }

        function durumOnayMesaji(yeniDurum) {
            const mesajlar = {
                Inceleniyor: "Arızayı incelemeye almak istediğinize emin misiniz?",
                Onariliyor: "Onarım sürecini başlatmak istediğinize emin misiniz?",
                Tamamlandi: "Arıza giderildi mi? Bu işlem geri alınamaz.",
                IptalEdildi: "Bu ihbarı iptal etmek istediğinize emin misiniz?"
            };

            return mesajlar[yeniDurum] || "Durumu güncellemek istediğinize emin misiniz?";
        }

        function durumAksiyonlariOlustur(id, durum) {
            const aksiyonlar = [];

            if (durum === "Beklemede") {
                aksiyonlar.push({
                    yeniDurum: "Inceleniyor",
                    sinif: "btn-primary",
                    ikon: "bi-search",
                    metin: "İncelet"
                });
            }
            else if (durum === "Inceleniyor" || durum === "İnceleniyor") {
                aksiyonlar.push({
                    yeniDurum: "Onariliyor",
                    sinif: "btn-warning",
                    ikon: "bi-tools",
                    metin: "Onart"
                });
            }
            else if (durum === "Onariliyor" || durum === "Onarılıyor") {
                aksiyonlar.push({
                    yeniDurum: "Tamamlandi",
                    sinif: "btn-success",
                    ikon: "bi-check-lg",
                    metin: "Tamamla"
                });
            }

            aksiyonlar.push({
                yeniDurum: "IptalEdildi",
                sinif: "btn-outline-danger",
                ikon: "bi-x-lg",
                metin: "İptal"
            });

            return aksiyonlar.map(aksiyon => `
                <button onclick="arizaDurumGuncelleAjax(${id}, '${aksiyon.yeniDurum}')"
                        class="btn btn-sm ${aksiyon.sinif} rounded-pill">
                    <i class="bi ${aksiyon.ikon}"></i>
                    ${aksiyon.metin}
                </button>
            `).join("");
        }

        async function arizaDurumGuncelleAjax(id, yeniDurum) {
            if (!confirm(durumOnayMesaji(yeniDurum))) return;

            try {
                const formData = new URLSearchParams();
                formData.append("id", id);
                formData.append("yeniDurum", yeniDurum);

                const response = await fetch('/Personel/DurumGuncelle', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: formData
                });

                if (!response.ok) {
                    alert("İşlem yapılırken hata oluştu.");
                    return;
                }

                location.reload();
            }
            catch {
                alert("Sunucu bağlantı hatası.");
            }
        }

        function haritayiYukle() {
            if (!personelMap) {
                personelMap = L.map('personelMap', {
                    scrollWheelZoom: true,
                    maxBounds: L.latLngBounds(L.latLng(34.0, 24.0), L.latLng(43.0, 46.0)),
                    maxBoundsViscosity: 1.0
                }).setView([38.9637, 35.2433], 6);

                L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                    attribution: '© OpenStreetMap',
                    minZoom: 6,
                    maxZoom: 18
                }).addTo(personelMap);
            }

            personelMarkers.forEach(marker => personelMap.removeLayer(marker));
            personelMarkers = [];

            personelArizalar.forEach(ariza => {
                let lat = ariza.enlem || ariza.Enlem;
                let lng = ariza.boylam || ariza.Boylam;

                lat = parseFloat(lat.toString().replace(',', '.'));
                lng = parseFloat(lng.toString().replace(',', '.'));

                while (lat > 90) lat /= 10;
                while (lng > 180) lng /= 10;

                if (isNaN(lat) || isNaN(lng)) return;

                const cozulduMu = ariza.cozulduMu ?? ariza.CozulduMu;
                const durum = normalizeDurum(ariza.durum ?? ariza.Durum);
                const bildirenAd = ariza.vatandas?.kullaniciAdi || ariza.Vatandas?.KullaniciAdi || "Bilinmiyor";
                const bildirenEposta = ariza.vatandas?.eposta || ariza.Vatandas?.Eposta || "-";
                const popup = `
                    <div class="p-1" style="width:220px">
                        <img src="${ariza.fotografYolu || ariza.FotografYolu || '/img/no-image.png'}" class="popup-img" onerror="this.src='/img/no-image.png'">
                        <h6 class="fw-bold mb-1">${ariza.baslik || ariza.Baslik}</h6>
                        <p class="small text-muted mb-2">${ariza.aciklama || ariza.Aciklama || "Açıklama yok"}</p>
                        <div class="small bg-white border rounded p-2 mb-2">
                            <strong>Bildiren:</strong> ${bildirenAd}<br>
                            <span class="text-muted">${bildirenEposta}</span>
                        </div>
                        <div class="small bg-light rounded p-2 mb-2">${ariza.adresTarifi || ariza.AdresTarifi || ""}</div>
                        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                            <span class="badge ${cozulduMu ? "bg-success" : "bg-danger"}">${durum}</span>
                            <button onclick="yolTarifiAl(${lat}, ${lng})" class="btn btn-sm btn-primary rounded-pill">
                                <i class="bi bi-sign-turn-right-fill"></i> Yol Tarifi
                            </button>
                        </div>
                        <div class="d-grid gap-2">
                            ${cozulduMu ? "" : durumAksiyonlariOlustur(ariza.id || ariza.Id, durum)}
                        </div>
                    </div>`;

                const marker = L.marker([lat, lng], { icon: markerIconOlustur(cozulduMu) })
                    .addTo(personelMap)
                    .bindPopup(popup);

                personelMarkers.push(marker);
            });
        }

        document.getElementById('personelHaritaBtn').addEventListener('shown.bs.tab', function () {
            haritayiYukle();
            setTimeout(() => personelMap.invalidateSize(), 150);
        });

        document.getElementById('personelAddressSearchInput')?.addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                personelAdresAra();
            }
        });

        document.getElementById('aktifArizaArama')?.addEventListener('input', aktifListeyiFiltrele);
        document.getElementById('aktifDurumFiltre')?.addEventListener('change', aktifListeyiFiltrele);
    </script>
}
