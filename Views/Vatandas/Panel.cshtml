@model List<ArizaSikayet.Models.Ariza>

@functions {
    private static string DurumBadgeClass(ArizaDurumu durum)
    {
        return durum switch
        {
            ArizaDurumu.Beklemede => "bg-secondary",
            ArizaDurumu.Inceleniyor => "bg-info text-dark",
            ArizaDurumu.Onariliyor => "bg-warning text-dark",
            ArizaDurumu.Tamamlandi => "bg-success",
            ArizaDurumu.IptalEdildi => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private static string ResimYolu(string? yol)
    {
        return string.IsNullOrWhiteSpace(yol) ? "/img/no-image.png" : yol;
    }
}

@{
    ViewData["Title"] = "Vatandaş Paneli";
    var aktif = Model.Where(x => !x.CozulduMu).ToList();
    var tamamlanan = Model.Where(x => x.CozulduMu).ToList();
    var kategoriler = ArizaKategorileri.TumKategoriler;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-circle text-danger me-2"></i>Vatandaş Paneli</h2>
        <div class="text-muted small">Bildirdiğiniz arızaları takip edin, aktif olanları gerektiğinde güncelleyin.</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Ariza" asp-action="Bildir" class="btn btn-danger rounded-pill px-3"><i class="bi bi-plus-circle"></i> Arıza Bildir</a>
        <a asp-action="SifreDegistir" class="btn btn-outline-warning rounded-pill px-3"><i class="bi bi-key"></i> Şifre</a>
        <a asp-action="Logout" class="btn btn-outline-danger rounded-pill px-3"><i class="bi bi-box-arrow-right"></i> Çıkış</a>
    </div>
</div>

@if (TempData["Mesaj"] != null)
{
    <div class="alert alert-success border-0 shadow-sm">@TempData["Mesaj"]</div>
}
@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm">@TempData["Hata"]</div>
}

<div class="row mb-4">
    <div class="col-md-4 mb-3"><div class="bg-white border rounded-3 p-3 shadow-sm"><div class="small text-muted">Toplam Bildirim</div><div class="fs-4 fw-bold">@Model.Count</div></div></div>
    <div class="col-md-4 mb-3"><div class="bg-white border rounded-3 p-3 shadow-sm"><div class="small text-muted">Aktif</div><div class="fs-4 fw-bold text-danger">@aktif.Count</div></div></div>
    <div class="col-md-4 mb-3"><div class="bg-white border rounded-3 p-3 shadow-sm"><div class="small text-muted">Tamamlanan</div><div class="fs-4 fw-bold text-success">@tamamlanan.Count</div></div></div>
</div>

<ul class="nav nav-pills mb-4" role="tablist">
    <li class="nav-item"><button class="nav-link active rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#listeTab"><i class="bi bi-table me-2"></i>Arızalarım</button></li>
    <li class="nav-item ms-2"><button class="nav-link rounded-pill px-4 border" id="vatandasHaritaBtn" data-bs-toggle="pill" data-bs-target="#haritaTab"><i class="bi bi-map me-2"></i>Harita</button></li>
    <li class="nav-item ms-2"><button class="nav-link rounded-pill px-4 border" data-bs-toggle="pill" data-bs-target="#resimlerTab"><i class="bi bi-images me-2"></i>Resimler</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="listeTab">
        <div class="card border-0 shadow-sm" style="border-radius:18px;">
            <div class="card-body p-3">
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input id="arizaArama" class="form-control" placeholder="Başlık veya adreste ara...">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select id="kategoriFiltre" class="form-select form-select-sm">
                            <option value="">Tüm kategoriler</option>
                            @foreach (var kategori in kategoriler)
                            {
                                <option value="@kategori">@ArizaKategorileri.Etiketler[kategori]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <select id="durumFiltre" class="form-select form-select-sm">
                            <option value="">Tüm durumlar</option>
                            <option value="Beklemede">Beklemede</option>
                            <option value="Inceleniyor">İnceleniyor</option>
                            <option value="Onariliyor">Onarılıyor</option>
                            <option value="Tamamlandi">Tamamlandı</option>
                            <option value="IptalEdildi">İptal Edildi</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="small text-muted text-uppercase">
                            <tr>
                                <th>Resim</th>
                                <th>Arıza</th>
                                <th>Kategori</th>
                                <th>Durum</th>
                                <th>Tarih</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var aranacak = $"{item.Baslik} {item.AdresTarifi}".ToLower(new System.Globalization.CultureInfo("tr-TR"));
                                var guncellenebilir = !item.CozulduMu && item.Durum != ArizaDurumu.Tamamlandi && item.Durum != ArizaDurumu.IptalEdildi;
                                <tr class="vatandas-ariza-row"
                                    data-search="@aranacak"
                                    data-kategori="@item.Kategori"
                                    data-durum="@item.Durum.ToString()">
                                    <td>
                                        <button type="button" class="btn p-0 border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#resimModal" data-resim="@ResimYolu(item.FotografYolu)" data-baslik="@item.Baslik">
                                            <img src="@ResimYolu(item.FotografYolu)" class="rounded shadow-sm" style="width:78px;height:58px;object-fit:cover;" alt="Arıza fotoğrafı">
                                        </button>
                                    </td>
                                    <td style="min-width:220px;">
                                        <div class="fw-bold">@item.Baslik</div>
                                        <div class="small text-muted">@item.AdresTarifi</div>
                                    </td>
                                    <td><span class="badge bg-danger">@item.Kategori</span></td>
                                    <td><span class="badge @DurumBadgeClass(item.Durum) rounded-pill">@item.Durum</span></td>
                                    <td class="small">@item.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <div class="d-flex flex-wrap gap-1 justify-content-end">
                                            @if (guncellenebilir)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-primary rounded-pill px-3 ariza-duzenle-btn"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#arizaDuzenleModal"
                                                        data-id="@item.Id"
                                                        data-baslik="@item.Baslik"
                                                        data-aciklama="@item.Aciklama"
                                                        data-kategori="@item.Kategori"
                                                        data-adres="@item.AdresTarifi"
                                                        data-resim="@ResimYolu(item.FotografYolu)">
                                                    <i class="bi bi-pencil-square"></i> Düzenle
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="small text-muted align-self-center">Kapandı</span>
                                            }

                                            <form asp-action="ArizaSil" method="post" class="m-0">
                                                <input type="hidden" name="id" value="@item.Id">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                        onclick="return confirm('Bu arıza bildiriminizi silmek istediğinize emin misiniz?')">
                                                    <i class="bi bi-trash"></i> Sil
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr><td colspan="6" class="text-center text-muted py-4">Henüz arıza bildiriminiz yok.</td></tr>
                            }
                            <tr id="filtreBosSatir" class="d-none">
                                <td colspan="6" class="text-center text-muted py-4">Filtrelere uygun arıza bulunamadı.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane fade" id="haritaTab">
        <div class="card border-0 shadow-sm" style="border-radius:18px; overflow:hidden;">
            <div class="card-body p-0"><div id="vatandasMap" style="height:70vh;width:100%;"></div></div>
        </div>
    </div>

    <div class="tab-pane fade" id="resimlerTab">
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-lg-3">
                    <button type="button" class="card border-0 shadow-sm text-start w-100 p-0" data-bs-toggle="modal" data-bs-target="#resimModal" data-resim="@ResimYolu(item.FotografYolu)" data-baslik="@item.Baslik" style="overflow:hidden; border-radius:12px;">
                        <img src="@ResimYolu(item.FotografYolu)" style="height:160px;object-fit:cover;width:100%;" alt="Arıza fotoğrafı">
                        <span class="p-3">
                            <span class="fw-bold d-block text-truncate">@item.Baslik</span>
                            <span class="small text-muted">@item.Durum</span>
                        </span>
                    </button>
                </div>
            }
            @if (!Model.Any())
            {
                <div class="col-12"><div class="text-center text-muted py-4">Gösterilecek resim yok.</div></div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="arizaDuzenleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <form id="arizaDuzenleForm" asp-action="ArizaGuncelle" method="post" enctype="multipart/form-data" class="modal-content border-0 shadow" style="border-radius:18px; overflow:hidden;">
            <div class="modal-header bg-dark text-white border-0">
                <h5 class="modal-title">Arıza Bildirimini Güncelle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="duzenleId" name="id">
                <div class="row g-3">
                    <div class="col-md-4">
                        <img id="duzenleResim" src="/img/no-image.png" class="rounded border w-100" style="height:180px;object-fit:cover;" alt="Mevcut fotoğraf">
                        <label class="form-label small fw-bold text-muted mt-3">Fotoğrafı Değiştir</label>
                        <input id="duzenleFotograf" type="file" name="fotograf" class="form-control form-control-sm" accept=".jpg,.jpeg,.png,image/jpeg,image/png">
                        <div class="form-text">Yalnızca JPG, JPEG veya PNG. En fazla 10MB.</div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-bold text-muted">Başlık</label>
                        <input id="duzenleBaslik" name="baslik" class="form-control mb-3" maxlength="30" required>

                        <label class="form-label small fw-bold text-muted">Açıklama</label>
                        <textarea id="duzenleAciklama" name="aciklama" class="form-control mb-3" maxlength="100" rows="3" required></textarea>

                        <label class="form-label small fw-bold text-muted">Kategori</label>
                        <select id="duzenleKategori" name="kategori" class="form-select mb-3" required>
                            @foreach (var kategori in kategoriler)
                            {
                                <option value="@kategori">@ArizaKategorileri.Etiketler[kategori]</option>
                            }
                        </select>

                        <label class="form-label small fw-bold text-muted">Adres / Konum Tarifi</label>
                        <textarea id="duzenleAdres" name="adresTarifi" class="form-control" rows="2" required></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4 pt-0">
                <button type="button" class="btn btn-light border rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4">Güncelle</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="resimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow" style="border-radius:18px; overflow:hidden;">
            <div class="modal-header bg-dark text-white border-0">
                <h5 id="resimModalBaslik" class="modal-title">Arıza Fotoğrafı</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <img id="resimModalImg" src="/img/no-image.png" class="w-100" style="max-height:75vh;object-fit:contain;background:#f8f9fa;" alt="Arıza fotoğrafı">
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <style>
        .leaflet-popup-content-wrapper { border-radius: 14px; box-shadow: 0 10px 25px rgba(0,0,0,.14) !important; }
        .popup-img { width: 100%; height: 110px; object-fit: cover; border-radius: 10px; margin-bottom: 8px; border: 1px solid #eee; }
    </style>
    <script>
        const vatandasArizalar = @Html.Raw(Json.Serialize(Model));
        let vatandasMap;

        function filtrele() {
            const arama = (document.getElementById('arizaArama')?.value || '').toLocaleLowerCase('tr-TR').trim();
            const kategori = document.getElementById('kategoriFiltre')?.value || '';
            const durum = document.getElementById('durumFiltre')?.value || '';
            const rows = Array.from(document.querySelectorAll('.vatandas-ariza-row'));
            let gorunen = 0;

            rows.forEach(row => {
                const uygun = (!arama || (row.dataset.search || '').includes(arama)) &&
                    (!kategori || row.dataset.kategori === kategori) &&
                    (!durum || row.dataset.durum === durum);
                row.classList.toggle('d-none', !uygun);
                if (uygun) gorunen++;
            });

            document.getElementById('filtreBosSatir')?.classList.toggle('d-none', gorunen !== 0 || rows.length === 0);
        }

        function normalizeDurum(durum) {
            const durumlar = { 0: "Beklemede", 1: "Inceleniyor", 2: "Onariliyor", 3: "Tamamlandi", 4: "IptalEdildi" };
            return durumlar[durum] || durum || "";
        }

        function durumRengi(durum) {
            const temiz = normalizeDurum(durum);
            if (temiz === "Beklemede") return "red";
            if (temiz === "Inceleniyor") return "blue";
            if (temiz === "Onariliyor") return "orange";
            if (temiz === "Tamamlandi") return "green";
            return "grey";
        }

        function markerIconOlustur(durum) {
            return L.icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${durumRengi(durum)}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
        }

        document.getElementById('vatandasHaritaBtn').addEventListener('shown.bs.tab', function () {
            if (!vatandasMap) {
                vatandasMap = L.map('vatandasMap', {
                    maxBounds: L.latLngBounds(L.latLng(34.0, 24.0), L.latLng(43.0, 46.0)),
                    maxBoundsViscosity: 1.0
                }).setView([38.9637, 35.2433], 6);

                L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                    attribution: '© OpenStreetMap',
                    minZoom: 6,
                    maxZoom: 18
                }).addTo(vatandasMap);

                vatandasArizalar.forEach(ariza => {
                    let lat = parseFloat((ariza.enlem || ariza.Enlem).toString().replace(',', '.'));
                    let lng = parseFloat((ariza.boylam || ariza.Boylam).toString().replace(',', '.'));
                    while (lat > 90) lat /= 10;
                    while (lng > 180) lng /= 10;
                    if (isNaN(lat) || isNaN(lng)) return;

                    const durum = normalizeDurum(ariza.durum ?? ariza.Durum);
                    L.marker([lat, lng], { icon: markerIconOlustur(durum) }).addTo(vatandasMap).bindPopup(`
                        <div style="width:220px">
                            <img src="${ariza.fotografYolu || ariza.FotografYolu || '/img/no-image.png'}" class="popup-img" onerror="this.src='/img/no-image.png'">
                            <strong>${ariza.baslik || ariza.Baslik}</strong><br>
                            <span class="badge bg-secondary mt-2">${durum}</span>
                            <div class="small mt-2">${ariza.adresTarifi || ariza.AdresTarifi || ""}</div>
                        </div>
                    `);
                });
            }
            setTimeout(() => vatandasMap.invalidateSize(), 150);
        });

        document.querySelectorAll('.ariza-duzenle-btn').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('duzenleId').value = button.dataset.id || '';
                document.getElementById('duzenleBaslik').value = button.dataset.baslik || '';
                document.getElementById('duzenleAciklama').value = button.dataset.aciklama || '';
                document.getElementById('duzenleKategori').value = button.dataset.kategori || '';
                document.getElementById('duzenleAdres').value = button.dataset.adres || '';
                document.getElementById('duzenleResim').src = button.dataset.resim || '/img/no-image.png';
            });
        });

        document.getElementById('resimModal')?.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            document.getElementById('resimModalImg').src = button?.dataset.resim || '/img/no-image.png';
            document.getElementById('resimModalBaslik').innerText = button?.dataset.baslik || 'Arıza Fotoğrafı';
        });

        document.getElementById('arizaDuzenleForm')?.addEventListener('submit', event => {
            const input = document.getElementById('duzenleFotograf');
            const file = input?.files?.[0];
            if (!file) return;

            const izinliTipler = ['image/jpeg', 'image/png'];
            const izinliUzantilar = ['.jpg', '.jpeg', '.png'];
            const dosyaAdi = file.name.toLocaleLowerCase('tr-TR');
            const uzantiUygun = izinliUzantilar.some(uzanti => dosyaAdi.endsWith(uzanti));

            if (file.size > 10 * 1024 * 1024) {
                event.preventDefault();
                alert('Fotoğraf 10MB’dan büyük olamaz.');
                return;
            }

            if (!izinliTipler.includes(file.type) || !uzantiUygun) {
                event.preventDefault();
                alert('Sadece JPG, JPEG veya PNG fotoğraf yüklenebilir. Video ve diğer dosya türleri kabul edilmez.');
            }
        });

        document.getElementById('arizaArama')?.addEventListener('input', filtrele);
        document.getElementById('kategoriFiltre')?.addEventListener('change', filtrele);
        document.getElementById('durumFiltre')?.addEventListener('change', filtrele);
    </script>
}
