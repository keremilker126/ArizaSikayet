@{
    Layout = null; // Admin girişi için layout kullanmıyoruz
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yönetim Paneli Girişi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background-color: #f8f9fa; display: flex; align-items: center; justify-content: center; height: 100vh; }
        .login-card { border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); width: 100%; max-width: 400px; }
    </style>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23111111'/%3E%3Cpath d='M20 30V22C20 15.4 25.4 10 32 10S44 15.4 44 22V30' stroke='%23ff2b2b' stroke-width='5' fill='none' stroke-linecap='round'/%3E%3Crect x='16' y='28' width='32' height='26' rx='6' fill='%23ff2b2b'/%3E%3Ccircle cx='32' cy='41' r='3.5' fill='white'/%3E%3C/svg%3E">
</head>
<body>
    <div class="card login-card border-0">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-shield-lock-fill text-danger fs-1"></i>
                <h4 class="fw-bold mt-2">Admin Girişi</h4>
                <p class="text-muted small">Sistemi yönetmek için giriş yapın</p>
            </div>
            
            <form asp-action="Login" asp-controller="Admin" method="post">
                @if (ViewBag.Hata != null) {
                    <div class="alert alert-danger p-2 small">@ViewBag.Hata</div>
                }
                <div class="mb-3">
                    <label class="form-label small fw-bold">Kullanıcı Adı</label>
                    <input type="text" name="kadi" class="form-control" maxlength="30" required>
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold">Şifre</label>
                    <input type="password" name="sifre" class="form-control" maxlength="30" required>
                </div>
                <div class="mb-4">
                    <label class="form-label small fw-bold">Güvenlik Kodu</label>
                    <div class="d-flex gap-2">
                        <div class="px-3 py-2 bg-light border rounded fw-bold text-danger">@ViewBag.GuvenlikKodu</div>
                        <input type="text" name="guvenlikKodu" class="form-control" maxlength="6" required>
                    </div>
                    <a asp-action="Login" class="small text-decoration-none d-inline-block mt-1">Kodu yenile</a>
                </div>
                <button type="submit" class="btn btn-dark w-100 py-2 fw-bold">GİRİŞ YAP</button>
            </form>
            
            <div class="text-center mt-4">
                <a href="/" class="text-decoration-none small text-secondary"><i class="bi bi-arrow-left"></i> Siteye Dön</a>
            </div>
        </div>
    </div>
</body>
</html>
